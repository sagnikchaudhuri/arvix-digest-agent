LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://127.0.0.1:11434
GEMINI_API_KEY=

# Optional alternatives:
# LLM_PROVIDER=mistral
# LLM_MODEL=mistral-small-latest
# MISTRAL_API_KEY=
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free

# Start Ollama separately in CPU-only mode (PowerShell); use Ollama's default
# model directory, or set OLLAMA_MODELS to a directory chosen on this machine:
# $env:OLLAMA_LLM_LIBRARY='cpu_avx2'
# $env:OLLAMA_HOST='127.0.0.1:11434'
# ollama serve

# Local data directories
PDF_DIR=data/papers
VECTOR_STORE_DIR=data/vector_store

# Embedding model identifier
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Maximum Chroma cosine distance for the direct question-to-paper relevance check
QA_MAX_COSINE_DISTANCE=0.81
